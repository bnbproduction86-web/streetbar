# ==========================================
# Root .gitignore for Street Bar POS Project
# ==========================================

# Dependencies
node_modules/
*/node_modules/
vendor/
backend/vendor/

# Environment files
.env
.env.*
!.env.example
backend/.env
backend/.env.*
!backend/.env.example
frontend/.env*
!frontend/.env.example

# Next.js / Build Outputs
.next/
*/.next/
out/
frontend/out/
build/
*/build/
dist/

# Logs & Runtime
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
backend/storage/logs/*.log
backend/storage/framework/cache/*
backend/storage/framework/sessions/*
backend/storage/framework/views/*
!backend/storage/logs/.gitignore
!backend/storage/framework/cache/.gitignore
!backend/storage/framework/sessions/.gitignore
!backend/storage/framework/views/.gitignore

# Android Gradle Builds & Caches
frontend/android/.gradle/
frontend/android/build/
frontend/android/app/build/
frontend/android/captures/
frontend/android/.idea/
frontend/android/*.iml
frontend/android/app/*.iml
frontend/android/local.properties
.gradle/

# IDE & Editor Files
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
.DS_Store
Thumbs.db
